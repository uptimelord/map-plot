# Configure privately on the server. Never put keys in the browser or Git.
GEMINI_API_KEY=
# Optional later: enables independent OCR cross-checking.
GOOGLE_VISION_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# A helper unlocks each device with this code. Minimum 12 characters.
APP_ACCESS_CODE=
# At least 32 random characters. Used only on the server.
SESSION_SECRET=
# Sites-hosted quota user-key salt; at least 32 random characters.
QUOTA_SALT=
APP_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
PORT=5173
DAILY_SCAN_LIMIT=100
LOG_REQUESTS=false
